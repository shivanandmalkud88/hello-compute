import React, { useState } from "react";

export default function NikeLanding() {
  const [query, setQuery] = useState("");
  const [cart, setCart] = useState([]);
  const [selected, setSelected] = useState(null);
  const [showCart, setShowCart] = useState(false);

  const products = [
    {
      id: 1,
      title: "Air Sprint Runner",
      price: 139,
      colors: ["Black", "White", "Volt"],
      img: "https://images.unsplash.com/photo-1527708676376-35a8df8b7a7f?q=80&w=1200&auto=format&fit=crop&ixlib=rb-4.0.3&s=9a0b5d5b3a9a6b2b6b2a",
      desc: "Lightweight runner with responsive foam and breathable mesh.",
    },
    {
      id: 2,
      title: "Court Classic Trainer",
      price: 119,
      colors: ["White", "Grey", "Blue"],
      img: "https://images.unsplash.com/photo-1519741499283-20b6a8c1f542?q=80&w=1200&auto=format&fit=crop&ixlib=rb-4.0.3&s=7ed3b6b4f9f27f2f0b7b",
      desc: "Retro court silhouette reimagined with modern cushioning.",
    },
    {
      id: 3,
      title: "Trail Explorer Boots",
      price: 159,
      colors: ["Tan", "Black"],
      img: "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?q=80&w=1200&auto=format&fit=crop&ixlib=rb-4.0.3&s=0a7a8c3c5a6a4d1d4b5d",
      desc: "Durable all-terrain boot with waterproof upper and grippy sole.",
    },
    {
      id: 4,
      title: "Everyday Hoodie",
      price: 79,
      colors: ["Black", "Olive", "Grey"],
      img: "https://images.unsplash.com/photo-1541099649105-f69ad21f3246?q=80&w=1200&auto=format&fit=crop&ixlib=rb-4.0.3&s=3b9f8b1a4f4c2f1b7a2c",
      desc: "Soft fleece hoodie with clean minimal branding.",
    },
  ];

  const filtered = products.filter((p) =>
    p.title.toLowerCase().includes(query.toLowerCase())
  );

  function addToCart(product) {
    setCart((c) => {
      const found = c.find((it) => it.id === product.id);
      if (found) return c.map((it) => (it.id === product.id ? { ...it, qty: it.qty + 1 } : it));
      return [...c, { ...product, qty: 1 }];
    });
    setShowCart(true);
  }

  function updateQty(id, delta) {
    setCart((c) =>
      c
        .map((it) => (it.id === id ? { ...it, qty: Math.max(1, it.qty + delta) } : it))
        .filter((it) => it.qty > 0)
    );
  }

  function total() {
    return cart.reduce((s, it) => s + it.price * it.qty, 0).toFixed(2);
  }

  return (
    <div className="min-h-screen bg-gradient-to-b from-white to-gray-50 text-gray-900">
      {/* Header */}
      <header className="sticky top-0 z-30 bg-white/80 backdrop-blur border-b">
        <div className="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
          <div className="flex items-center space-x-4">
            <div className="text-2xl font-bold">Swoosh</div>
            <nav className="hidden md:flex gap-4 text-sm">
              <a className="hover:underline" href="#">Men</a>
              <a className="hover:underline" href="#">Women</a>
              <a className="hover:underline" href="#">Kids</a>
              <a className="hover:underline" href="#">New Releases</a>
            </nav>
          </div>

          <div className="flex items-center gap-4">
            <div className="hidden md:block">
              <input
                aria-label="Search"
                value={query}
                onChange={(e) => setQuery(e.target.value)}
                placeholder="Search products"
                className="px-3 py-2 rounded-full border w-64 text-sm"
              />
            </div>
            <button
              onClick={() => setShowCart((s) => !s)}
              aria-label="Open cart"
              className="relative p-2 rounded-full hover:bg-gray-100"
            >
              <svg className="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2 6m5-6v6m4-6v6m1 0h3" />
              </svg>
              {cart.length > 0 && (
                <span className="absolute -top-1 -right-1 bg-red-600 text-white rounded-full text-xs w-5 h-5 flex items-center justify-center">{cart.reduce((s, i) => s + i.qty, 0)}</span>
              )}
            </button>
          </div>
        </div>
      </header>

      {/* Hero */}
      <section className="max-w-6xl mx-auto px-6 py-12 grid md:grid-cols-2 gap-8 items-center">
        <div>
          <span className="inline-block px-3 py-1 text-xs bg-black text-white rounded-full">New Arrival</span>
          <h1 className="mt-6 text-4xl md:text-5xl font-extrabold leading-tight">Move fast. Look good.</h1>
          <p className="mt-4 text-gray-600 max-w-lg">Performance footwear and apparel engineered for speed, comfort, and style. Shop the latest.</p>

          <div className="mt-6 flex gap-3">
            <button className="px-6 py-3 rounded-full bg-black text-white font-semibold hover:opacity-90">Shop Men</button>
            <button className="px-6 py-3 rounded-full border font-semibold">Shop Women</button>
          </div>

          <div className="mt-8 grid grid-cols-2 gap-4">
            <div className="p-4 bg-white rounded-lg shadow-sm">
              <div className="text-sm font-medium">Cushioning</div>
              <div className="text-xs text-gray-500">Lightweight foam for everyday comfort</div>
            </div>
            <div className="p-4 bg-white rounded-lg shadow-sm">
              <div className="text-sm font-medium">Breathability</div>
              <div className="text-xs text-gray-500">Engineered mesh to keep you cool</div>
            </div>
          </div>
        </div>

        <div className="relative">
          <img src={products[0].img} alt="hero" className="rounded-2xl shadow-2xl w-full object-cover h-96" />
          <div className="absolute left-6 bottom-6 bg-white p-4 rounded-2xl shadow">
            <div className="text-sm font-medium">{products[0].title}</div>
            <div className="text-xs text-gray-500">From ${products[0].price}</div>
          </div>
        </div>
      </section>

      {/* Product Grid */}
      <section className="max-w-6xl mx-auto px-6 pb-16">
        <div className="flex items-center justify-between">
          <h2 className="text-2xl font-bold">Featured</h2>
          <div className="text-sm text-gray-600">Showing {filtered.length} results</div>
        </div>

        <div className="mt-6 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
          {filtered.map((p) => (
            <article key={p.id} className="bg-white rounded-xl shadow hover:shadow-lg overflow-hidden">
              <div className="relative">
                <img src={p.img} alt={p.title} className="w-full h-56 object-cover" />
                <button
                  onClick={() => setSelected(p)}
                  className="absolute right-3 top-3 bg-white p-2 rounded-full shadow"
                  aria-label={`View ${p.title}`}
                >
                  <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" d="M15 10l4.553-2.276A2 2 0 0122 9.618V18a2 2 0 01-2 2H6a2 2 0 01-2-2V6a2 2 0 012-2h8" />
                  </svg>
                </button>
              </div>

              <div className="p-4">
                <h3 className="font-semibold">{p.title}</h3>
                <p className="text-sm text-gray-500 mt-1">{p.desc}</p>
                <div className="mt-4 flex items-center justify-between">
                  <div className="text-lg font-bold">${p.price}</div>
                  <div className="flex items-center gap-2">
                    <button onClick={() => addToCart(p)} className="px-3 py-2 rounded-full bg-black text-white text-sm">Add</button>
                    <button onClick={() => setSelected(p)} className="px-3 py-2 rounded-full border text-sm">Details</button>
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      {/* Footer */}
      <footer className="border-t bg-white">
        <div className="max-w-6xl mx-auto px-6 py-10 grid md:grid-cols-4 gap-6">
          <div>
            <div className="text-2xl font-bold">Swoosh</div>
            <p className="text-sm text-gray-600 mt-3">Designed for movement. Built to last.</p>
          </div>
          <div>
            <h4 className="font-semibold">Company</h4>
            <ul className="mt-3 text-sm text-gray-600 space-y-2">
              <li>About</li>
              <li>Careers</li>
              <li>Sustainability</li>
            </ul>
          </div>
          <div>
            <h4 className="font-semibold">Support</h4>
            <ul className="mt-3 text-sm text-gray-600 space-y-2">
              <li>Help Center</li>
              <li>Shipping</li>
              <li>Returns</li>
            </ul>
          </div>
          <div>
            <h4 className="font-semibold">Subscribe</h4>
            <p className="text-sm text-gray-600 mt-3">Get updates on new drops and exclusive offers.</p>
            <div className="mt-3 flex">
              <input className="px-3 py-2 border rounded-l-md flex-1 text-sm" placeholder="Your email" />
              <button className="px-4 py-2 bg-black text-white rounded-r-md">Sign</button>
            </div>
          </div>
        </div>
        <div className="text-center text-xs text-gray-400 py-6">© {new Date().getFullYear()} Swoosh. All rights reserved.</div>
      </footer>

      {/* Product Modal */}
      {selected && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/50" onClick={() => setSelected(null)}>
          <div className="bg-white rounded-2xl max-w-3xl w-full mx-4 overflow-hidden" onClick={(e) => e.stopPropagation()}>
            <div className="grid md:grid-cols-2">
              <img src={selected.img} alt={selected.title} className="w-full h-96 object-cover" />
              <div className="p-6">
                <h3 className="text-2xl font-bold">{selected.title}</h3>
                <p className="text-gray-600 mt-3">{selected.desc}</p>
                <div className="mt-4">Price: <span className="font-bold text-lg">${selected.price}</span></div>
                <div className="mt-4">
                  <div className="text-sm text-gray-500">Available colors</div>
                  <div className="flex gap-2 mt-2">
                    {selected.colors.map((c) => (
                      <div key={c} className="px-3 py-1 border rounded-full text-sm">{c}</div>
                    ))}
                  </div>
                </div>
                <div className="mt-6 flex gap-3">
                  <button onClick={() => addToCart(selected)} className="px-4 py-3 rounded-full bg-black text-white font-semibold">Add to cart</button>
                  <button onClick={() => setSelected(null)} className="px-4 py-3 rounded-full border">Close</button>
                </div>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* Cart Drawer */}
      <div className={`fixed right-0 top-0 h-full z-50 transition-transform transform ${showCart ? "translate-x-0" : "translate-x-full"}`}>
        <div className="w-96 max-w-full h-full bg-white shadow-2xl flex flex-col">
          <div className="p-4 border-b flex items-center justify-between">
            <h4 className="font-semibold">Your Cart</h4>
            <button onClick={() => setShowCart(false)} className="p-2 rounded-full hover:bg-gray-100">✕</button>
          </div>
          <div className="p-4 flex-1 overflow-auto">
            {cart.length === 0 ? (
              <div className="text-gray-500">Your cart is empty.</div>
            ) : (
              cart.map((it) => (
                <div key={it.id} className="flex items-center gap-3 mb-4">
                  <img src={it.img} alt={it.title} className="w-16 h-16 object-cover rounded-md" />
                  <div className="flex-1">
                    <div className="font-semibold">{it.title}</div>
                    <div className="text-sm text-gray-500">${it.price} • Qty {it.qty}</div>
                    <div className="mt-2 flex items-center gap-2">
                      <button onClick={() => updateQty(it.id, -1)} className="px-2 py-1 border rounded">-</button>
                      <button onClick={() => updateQty(it.id, +1)} className="px-2 py-1 border rounded">+</button>
                    </div>
                  </div>
                </div>
              ))
            )}
          </div>
          <div className="p-4 border-t">
            <div className="flex items-center justify-between mb-4">
              <div className="text-sm text-gray-600">Subtotal</div>
              <div className="font-semibold">${total()}</div>
            </div>
            <button className="w-full py-3 rounded-full bg-black text-white font-semibold">Checkout</button>
          </div>
        </div>
      </div>
    </div>
  );
}
